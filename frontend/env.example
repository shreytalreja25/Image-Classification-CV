# Development Mode (true for local, false for production)
REACT_APP_DEV_MODE=true

# Backend URLs
REACT_APP_LOCAL_BACKEND_URL=http://localhost:8000
REACT_APP_PRODUCTION_BACKEND_URL=https://your-backend.onrender.com

# Frontend URLs
REACT_APP_LOCAL_FRONTEND_URL=http://localhost:3000
REACT_APP_PRODUCTION_FRONTEND_URL=https://your-frontend.vercel.app

# WebSocket URLs
REACT_APP_LOCAL_WS_URL=ws://localhost:8000/ws
REACT_APP_PRODUCTION_WS_URL=wss://your-backend.onrender.com/ws

# App Configuration
REACT_APP_APP_NAME=Aerial Classification Dashboard
REACT_APP_APP_VERSION=1.0.0
REACT_APP_APP_DESCRIPTION=AI-powered aerial landscape classification dashboard
