# Development Mode (True for local, False for production)
DEV_MODE=True

# Backend URLs
LOCAL_BACKEND_URL=http://localhost:8000
PRODUCTION_BACKEND_URL=https://your-backend.onrender.com

# Frontend URLs
LOCAL_FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://your-frontend.vercel.app

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aerial_classification?retryWrites=true&w=majority
MONGODB_DB=aerial_classification

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Paths
MODEL_PATH=./models/
DATASET_PATH=./subset/

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
